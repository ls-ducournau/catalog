  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "eval:recos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/evaluate-recommendations.mjs",
