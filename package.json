    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "unrs-resolver@1.12.2": true
