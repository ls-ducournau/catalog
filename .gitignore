# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# base de données locale (spec: specs/duels-elo-v1.md section 7)
/data/*.db
/data/*.db-*
# sauvegardes automatiques (avant backfill, avant réinitialisation de l'Elo) : données personnelles
/data/backups/

# typescript
*.tsbuildinfo
next-env.d.ts

# système de design v2 : captures et résultats Playwright (données personnelles, locales)
/tests/.results/
/tests/visual/captures/

# scripts et captures temporaires (agents, essais)
/.tmp-*
